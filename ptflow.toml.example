# ─────────────────────────────────────────────────────────────────────────────
# ptflow — run config (operator knobs). Optional: pass with `--config ptflow.toml`.
# Precedence:  --set CLI  >  PTFLOW_* env var  >  this file  >  code default.
# NB: the ~119 internal tuning constants (rates/caps/timeouts/thresholds) are NOT here on purpose —
#     they are versioned expert defaults in the code; the risky rate knobs are bundled under `profile`.
# A copy of the EFFECTIVE values (secrets redacted) is written to <activity>/config.toml each run.
# ─────────────────────────────────────────────────────────────────────────────

# Rate profile (wide|home) — the network aggressiveness, resolved at startup:
#   wide = full bandwidth (naabu -rate 1000, nuclei -rl 150, high ferox -t/-L) — a fast server/line;
#   home = throttled (naabu 300, nuclei 50, low ferox) for a domestic line / consumer NAT that the
#          full-port scan or nuclei would otherwise choke. Set "home" on a home ADSL/FTTH connection.
profile = "wide"

# GLOBAL cap on concurrent network stages (per-app + spanning together). Bounds the aggregate load on
# the uplink and the target. Lower it (e.g. 4–6) to be gentler; default 4 with profile=home else 10.
net_limit = 10

# Operator session headers/cookies — WEBSCAN ONLY. Threaded into the web scanning tools so crawl/fuzz/DAST
# reach the AUTHENTICATED surface (where most POST/JSON lives). Ignored by external to avoid spraying auth
# across broad discovery. Put your login cookie or a Bearer here. SECRET → redacted in the snapshot.
# List of "Name: value" strings.
http_header = ["Cookie: session=PUT-YOURS-HERE"]

# OAST gate for Dalfox blind-XSS. Nuclei DAST executes every enabled-pack template, including OAST;
# configure interactsh.server below when callbacks must not use ProjectDiscovery's public servers.
# Dalfox additionally needs interactsh-client >=1.3.
oast = false

# Recrawl behavior (phase 3) when fuzzing opens never-crawled territory:
#   on      = re-seed katana on the new entry points (default);
#   preview = write/log the seeds (raw/recrawl/seeds.txt) WITHOUT crawling — to review them first;
#   off     = skip entirely.
recrawl = "on"

# Content-discovery deep dive (phase 3): huge Assetnote "manual" lists (1–4M) on the few high-value
# hosts. OFF by default — costs HOURS/host. Turn on only for a deep assessment.
deep_dive = false

# ── Optional LLM layer ──────────────────────────────────────────────────────
# Named providers supply their standard base URL. Model is always explicit for reproducibility.
# Remote providers receive assessment evidence. Secret values are redacted by default; still confirm
# the engagement's data-handling rules. Ready-to-run presets: configs/ai/*.toml.
[ai]
enabled = false
provider = "ollama"          # ollama | ollama-cloud | openrouter | huggingface | openai-compatible | claude-code
model = "gpt-oss:20b"        # Must exist locally for Ollama; use the provider's model ID remotely.
# base_url = "http://127.0.0.1:11434/v1" # Optional for named providers; required for openai-compatible.
cache = true
concurrency = 2
timeout_seconds = 180
max_retries = 2
max_calls = 50
max_input_tokens = 250000
max_output_tokens = 30000
max_cost = "0"               # Disabled at 0; enforced when the provider reports cost.
remote_secrets = "redacted"  # off | redacted | full

# Optional stage routing; omitted fields inherit [ai]. See configs/ai/mixed.toml for a complete hybrid.
# [ai.stages.cve_poc]
# enabled = true              # Interprets search_vulns poc/exploits; no Nuclei or arbitrary commands.
# max_output_tokens = 6000
# [ai.stages.report]
# provider = "openrouter"
# model = "openai/gpt-oss-20b"
# max_output_tokens = 12000

# ── Nuclei DAST packs ───────────────────────────────────────────────────────
# Every template in every enabled local pack runs in BOTH DAST passes. There are no tag/ID policies.
# Pin external sources with revision for reproducible evidence.
[dast]
aggression = "high"          # Include low/medium/high payload groups from every selected template.
fuzz_param_frequency = 10000 # Avoid suppressing repeated parameter names across the request corpus.
packs = [
  { name = "official", path = "~/nuclei-templates/dast", source = "projectdiscovery" }, # Add a pinned release/commit as revision when managed externally.
  { name = "ptflow-stable", path = "@ptflow/stable", source = "ptflow", revision = "bundled" },
  { name = "engagement", path = "./rules/nuclei-dast", source = "engagement", enabled = false },
]

# ── External tool path overrides ────────────────────────────────────────────
# Only if a binary isn't in its default location; the relevant stage skips best-effort if it's absent.
[tools]
sqlmap = "/opt/sqlmap-dev/sqlmap.py"               # SQLi scanner (run via sys.executable). Path to sqlmap.py.
search_vulns = "~/.local/bin/search_vulns"         # OFFLINE CVE correlation over enumerated software (local DB).
# nuclei_dast_templates = "~/nuclei-templates/dast" # Legacy single-pack fallback when dast.packs is absent.
eyewitness = ""                                    # EyeWitness override (empty = auto-resolved / /opt/EyeWitness).

# ── Global wordlists ────────────────────────────────────────────────────────
[wordlists]
# Search dir for the global lists (SecLists/Assetnote): roles are resolved by discovery in here.
dir = "/opt/wordlist"

# Pin a specific file for a ROLE (wins over discovery). Roles: content · wordpress · drupal · joomla ·
# params · an_* · mn_*. Useful to fix exactly which list a role uses.
[wordlists.roles]
# content = "onelistforallmicro.txt"
# params  = "burp-parameter-names.txt"

# ── Self-hosted OAST (alternative to the public servers) ────────────────────
[interactsh]
# Self-hosted interactsh server(s) instead of the public oast.* — keeps callbacks (and any data
# exfiltrated in the OOB request) off third-party infra. Empty = public servers by default.
server = ""
# Auth token for a protected/self-hosted interactsh server. SECRET → redacted in the snapshot.
token = ""

# ── Per-step on/off toggles (debug) ─────────────────────────────────────────
# Disable named stages for a run. Sparse: only what you list changes; everything else stays ON.
# Names are validated against the pipeline's live stages — see them with `ptflow steps <pipeline>`.
# One-off equivalent:  --set steps.external.dast=off
# [steps.external]
# nuclei_scope = false      # skip the whole-scope nuclei spanning scan
# dast = false              # skip the phase-2 DAST (its dependents still run, on absent inputs)
